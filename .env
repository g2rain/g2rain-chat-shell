VITE_CONTEXT_PATH=/chat
VITE_SERVER_PORT=3000
VITE_BACKEND_ORIGIN=https://demo.g2rain.com
VITE_APPLICATION_CODE=g2rain-chat-shell
VITE_SSO_BASE_URL=https://demo.g2rain.com
VITE_AUTH_END_POINT=/auth/authorize
VITE_TOKEN_END_POINT=/auth/token
