# Example Nginx config for the Main Shell static build.
# Replace chat with the path segment without leading slash (e.g. admin).

server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # SPA under context path
    location /chat/ {
        try_files $uri $uri/ /chat/index.html;
    }

    location = /chat {
        return 302 /chat/;
    }

    # Optional: proxy API to Gateway (adjust upstream in real deployments)
    # location /api/ {
    #     proxy_pass http://gateway:8080/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    # }
}
